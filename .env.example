# Copy this file to `.env` on the server and fill in real values.
# `.env` is never committed to git.

# A password for the Postgres database container. Make up any long random
# string - you'll never need to type it yourself.
POSTGRES_PASSWORD=

# Used to sign login sessions. Any random string of 32+ characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# The password you'll use to log into /admin. 10+ characters.
ADMIN_PASSWORD=

# From the Razorpay dashboard (Settings -> API Keys). Use the LIVE keys
# only once you're ready to accept real payments; use the test keys
# (starting rzp_test_) until then.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From the Razorpay dashboard (Settings -> Webhooks), after creating a
# webhook pointing at https://<your-domain>/api/webhooks/razorpay.
# Optional but recommended - leave blank to skip webhook verification.
RAZORPAY_WEBHOOK_SECRET=

# The site's real public URL, e.g. https://huskandhoney.in
SITE_URL=

# Optional: transactional email (order confirmations) via Resend.
# Leave all three blank to skip sending email - orders still work fine,
# emails are just logged instead of sent.
RESEND_API_KEY=
MAIL_FROM=
OWNER_EMAIL=
