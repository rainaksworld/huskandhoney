# Copy this file to `.env` on the server and fill in real values.
# `.env` is never committed to git.

# A password for the Postgres database container. Make up any long random
# string - you'll never need to type it yourself.
POSTGRES_PASSWORD=

# Used to sign login sessions. Any random string of 32+ characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# The password you'll use to log into /admin. 10+ characters.
ADMIN_PASSWORD=

# From the Razorpay dashboard (Settings -> API Keys). Use the LIVE keys
# only once you're ready to accept real payments; use the test keys
# (starting rzp_test_) until then.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From the Razorpay dashboard (Settings -> Webhooks), after creating a
# webhook pointing at https://<your-domain>/api/webhooks/razorpay.
# Optional but recommended - leave blank to skip webhook verification.
RAZORPAY_WEBHOOK_SECRET=

# The site's real public URL, e.g. https://huskandhoney.in
SITE_URL=

# Optional: transactional email (order confirmations and packed/shipped/
# delivered updates) via Resend. Leave blank to skip sending email - orders
# still work fine, emails are just logged instead of sent.
# MAIL_FROM must be on a domain verified in Resend, e.g.
#   MAIL_FROM=Husk & Honey <orders@huskandhoney.in>
RESEND_API_KEY=
MAIL_FROM=
OWNER_EMAIL=

# Optional: Google Sheet that gets a new row for every paid order.
# See docs/google-sheet-setup.md. The secret is any random string; put the
# same value in the Apps Script so only this server can write to the sheet.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Optional: WhatsApp messages. Not connected to a provider yet - see
# src/server/whatsapp.ts. OWNER_WHATSAPP is the number that gets a message
# for every new order, e.g. 9876543210.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
OWNER_WHATSAPP=

# While true, visitors see a "coming soon" page instead of the real site.
# /admin still works as normal so you (and Claude) can keep building behind
# the scenes. Set to false and restart the app container when ready to launch:
#   docker compose up -d app
COMING_SOON=true

# A secret phrase that lets you browse the real site while COMING_SOON is on.
# Visit https://<your-domain>/?preview=<this value> once in a browser and it
# remembers you for 30 days. Leave blank to disable this.
PREVIEW_KEY=
